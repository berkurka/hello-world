# Public URL used in RSVP links (no trailing slash).
# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app (or omit and VERCEL_URL is used)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP (required to send invite emails).
# Resend: host smtp.resend.com, username resend, password = your API key.
# https://resend.com/docs/send-with-smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_api_key
# Use an address on a domain you have verified in Resend before sending to guests or hosts.
# onboarding@resend.dev only delivers to the Resend account owner.
MAIL_FROM=onboarding@resend.dev
FROM_NAME=Partyz
# Daily send cap. Defaults to 100 (Resend free plan). Each address counts, including a second family email.
# Set a higher number after upgrading Resend, or 0 to turn the local cap off.
# MAIL_DAILY_LIMIT=100

# Legacy Gmail fallback. Used only when SMTP_HOST, SMTP_USER, SMTP_PASS, and MAIL_FROM are not all set.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Database:
# Local (default): SQLite file at ./data/invite.db — no extra setup.
# Vercel without these: temporary file:/tmp/invite.db (preview works, data may vanish).
# Production: Turso/libSQL free tier so data persists.
#   https://turso.tech → create a DB → copy URL + token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Party images are stored in the same database as events (local SQLite or Turso).
# No extra blob-storage keys are required. Max 1 MB. JPEG/PNG/WebP/GIF only.
