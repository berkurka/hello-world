# Public URL used in RSVP links (no trailing slash).
# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app (or omit and VERCEL_URL is used)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gmail SMTP (required to send invite emails)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
FROM_NAME=Invite

# Database:
# Local (default): SQLite file at ./data/invite.db — no extra setup.
# Vercel: Turso/libSQL free tier (SQLite files are not persistent on serverless)
#   https://turso.tech → create a DB → copy URL + token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
